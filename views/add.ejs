<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Добавить вопрос</title>
</head>
<body>
    <style>
        body{
            background-color: rgb(19, 19, 19);
            color: #EFE7DA;
        }
        header{
            display: flex;
            gap: 55%;
            background-color: rgba(0, 0, 0, 0);
            padding-left: 5%;
            border-radius: 15px;
            border: 1px rgb(199, 201, 202) solid;
        }
        header div{
            display: flex;
            gap: 20%;
            align-items: center;
        }
        header div a{
            text-decoration: none;
            color: #EFE7DA;
            transition: all ease 0.3s;
        }
        header div a:hover{
            background-color: #efe7da57;
            padding: 5%;
            border-radius: 5px;
        }
        main{
            padding: 0% 20% 0% 20%;
        }
        form{
            padding: 6%;
            background-color: #efe7da57;
            border-radius: 15px;
            margin-top: 5%;
            text-align: center;
            border: #dbd2c6 1px solid;
        }
        form input{
            width: 60%;
            background-color: #efe7da8f;
            border: 0px;
            border-radius: 5px;
            height: 20px;
            color: #EFE7DA;
            padding: 0.8%;
            margin-top: 4%;
        }
        form button{
            background-color: #efe7da8f;
            color: #EFE7DA;
            border: 1px #EFE7DA solid;
            border-radius: 5px;
            width: 70%;
            margin-top: 5%;
            padding-top: 1%;
            padding-bottom: 1%;
            transition: all ease 0.3s;
        }
        form button:hover{
            transform: scale(1.15);
        }
        form label{
            margin-right: 10px;
        }
    </style>

    <header>
        <h1>Forum</h1>
        <div>
            <p><a href="/">Главная</a></p>
            <p><a href="/form">Создать&nbsp;вопрос</a></p>
            <p><a href="/about">О&nbsp;нас</a></p>
        </div>
    </header>

    <main>
        <form action="/posts/add" method="post">
            <h1>Задать вопрос</h1>
            <label for="title">Заголовок:</label>
            <input name="title" placeholder="Заголовок(Сам вопрос)"><br>
            <label for="body">Подробнее:</label>
            <input name="body" placeholder="Подробнее(может предыстория)"><br>
            <label for="author">Автор:</label>
            <input name="author" placeholder="Автор"><br>
            <button type="submit">Отправить</button>
        </form>
    </main>
</body>
</html>