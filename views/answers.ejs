<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ответы</title>
</head>
<body>
    <style>
        body{
            background-color: rgb(19, 19, 19);
            color: #EFE7DA;
        }
        header{
            display: flex;
            gap: 55%;
            background-color: rgba(0, 0, 0, 0);
            padding-left: 5%;
            border-radius: 15px;
            border: 1px rgb(199, 201, 202) solid;
        }
        header div{
            display: flex;
            gap: 20%;
            align-items: center;
        }
        header div a{
            text-decoration: none;
            color: #EFE7DA;
            transition: all ease 0.3s;
        }
        header div a:hover{
            background-color: #efe7da57;
            padding: 5%;
            border-radius: 5px;
        }
        main{
            padding: 0% 20% 0% 20%;
        }
        .answers{
            background-color: #efe7da57;
            padding: 3%;
            border-radius: 15px;
            margin-top: 7%;
        }
        .answer{
            background-color: #efe7da2c;
            padding: 1px;
            margin-top: 2%;
            border-radius: 10px;
        }
        form{
            margin-top: 2%;
            text-align: center;
        }
        form input{
            width: 60%;
            background-color: #efe7da8f;
            border: 0px;
            border-radius: 5px;
            height: 20px;
            color: #EFE7DA;
            padding: 0.8%;
        }
        form button{
            width: 20%;
            background-color: #efe7da8f;
            color: #EFE7DA;
            border: 0px;
            border-radius: 5px;
            padding: 1%;
        }
    </style>

    <header>
        <h1>Forum</h1>
        <div>
            <p><a href="/">Главная</a></p>
            <p><a href="/form">Создать&nbsp;вопрос</a></p>
            <p><a href="/about">О&nbsp;нас</a></p>
        </div>
    </header>

    <main>
        <div class="answers">
            <% answers.forEach(answer => { %>
                <div class="answer">
                    <p><%= answer %></p>
                </div>
            <% }) %>
        </div>

        <form action="/answers/<%= id %>" method="post">
            <input name="body" placeholder="Введите комментарий">
            <button type="submit">Отправить</button>
        </form>
    </main>
</body>
</html>