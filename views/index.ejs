<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SoftForum - Главная</title>
    <link rel="stylesheet" href="css/style_index.css">
</head>
<body>
    <header class="header">
        <div class="container">
            <div class="header-content">
                <a href="index.html" class="logo">SoftForum</a>
                <div class="nav">
                    <a href="/">Главная</a>
                    <a href="/about">О нас</a>
                    <a href="/form">Создать тему</a>
                    <a href="/sign_in">Войти</a>
                    <a href="/registr" class="btn btn-primary">Регистрация</a>
                </div>
            </div>
        </div>
    </header>

    <main class="main">
        <div class="container">
            <div class="quick-actions">
                <div>
                    <h2>Добро пожаловать в SoftForum</h2>
                    <p style="color: #8B949E;">Сообщество дружных энтузиастов</p>
                </div>
                <a href="/form" class="btn btn-primary">➕ Создать тему</a>
            </div>

            <h1 class="page-title">Актуальные темы</h1>
            
            <div class="topics-grid">
                <% posts.forEach(post => { %>
                    <div class="topic-card">
                        <div class="topic-title">
                            <a href="/answers/<%= post.id %>"><%= post.title %></a>
                        </div>
                        <div class="topic-meta">
                            <span>👤 <%= post.author %></span>
                        </div>
                        <div class="topic-excerpt">
                            <%= post.body %>
                        </div>
                        <div class="topic-tags">
                            <% if (post.tags == null) { %>

                            <% } else { %>
                                <% post.tags.forEach(tag => { %>
                                    <span class="tag"><%= tag %></span>
                                <% }) %>
                            <% } %>
                        </div>
                        <a href="/posts/delete/<%= post.id %>" class="btn-delete">Удалить</a>
                    </div>
                <% }) %>
            </div>
        </div>
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <p>© 2025 SoftForum. Сообщество разработчиков и IT-специалистов.</p>
                <p style="margin-top: 10px; font-size: 14px;">Присоединяйтесь к нашему дружному сообществу!</p>
            </div>
        </div>
    </footer>
</body>
</html>