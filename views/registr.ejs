<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SoftForum - Регистрация</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', sans-serif;
            background: #121417;
            color: #EAECEF;
            line-height: 1.6;
        }

        .header {
            background: #1A1D21;
            border-bottom: 1px solid #2A2F35;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 0;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #6C9BD2;
            text-decoration: none;
            transition: color 0.3s;
        }

        .logo:hover {
            color: #7EABDA;
        }

        .nav {
            display: flex;
            gap: 24px;
            align-items: center;
        }

        .nav a {
            color: #EAECEF;
            text-decoration: none;
            transition: color 0.3s;
        }

        .nav a:hover {
            color: #6C9BD2;
        }

        .btn {
            padding: 8px 16px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background: #6C9BD2;
            color: #121417;
        }

        .btn-primary:hover {
            background: #7EABDA;
            transform: translateY(-1px);
        }

        .main {
            padding: 60px 0;
            min-height: calc(100vh - 200px);
            display: flex;
            align-items: center;
        }

        .auth-container {
            max-width: 500px;
            margin: 0 auto;
            background: #1A1D21;
            border-radius: 12px;
            padding: 40px;
            border: 1px solid #2A2F35;
        }

        .auth-title {
            text-align: center;
            margin-bottom: 32px;
            font-size: 28px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 12px;
            background: #25292E;
            border: 1px solid #2A2F35;
            border-radius: 6px;
            color: #EAECEF;
            font-size: 16px;
            transition: all 0.3s;
        }

        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: #6C9BD2;
            box-shadow: 0 0 0 3px rgba(108, 155, 210, 0.1);
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 24px;
        }

        .checkbox-group input {
            width: auto;
            cursor: pointer;
        }

        .success-message {
            background: #1E2A1E;
            border-left: 4px solid #5A8C5A;
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 20px;
            color: #5A8C5A;
            font-size: 14px;
            display: none;
        }

        .error-message {
            background: #2A1F1F;
            border-left: 4px solid #B5756B;
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 20px;
            color: #B5756B;
            font-size: 14px;
            display: none;
        }

        .password-strength {
            margin-top: 8px;
            font-size: 12px;
        }

        .strength-weak { color: #B5756B; }
        .strength-medium { color: #D4A06A; }
        .strength-strong { color: #5A8C5A; }

        .auth-footer {
            text-align: center;
            margin-top: 24px;
            padding-top: 24px;
            border-top: 1px solid #2A2F35;
            color: #8B949E;
        }

        .auth-footer a {
            color: #6C9BD2;
            text-decoration: none;
        }

        .auth-footer a:hover {
            text-decoration: underline;
        }

        .footer {
            background: #1A1D21;
            border-top: 1px solid #2A2F35;
            padding: 30px 0;
        }

        .footer-content {
            text-align: center;
            color: #5C6670;
        }

        @media (max-width: 768px) {
            .header-content {
                flex-direction: column;
                gap: 16px;
            }
            
            .auth-container {
                padding: 24px;
            }
            
            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="container">
            <div class="header-content">
                <a href="index.html" class="logo">SoftForum</a>
                <div class="nav">
                    <a href="index.html">Главная</a>
                    <a href="about.html">О нас</a>
                    <a href="answers.html">Ответы</a>
                    <a href="sign_in.html">Войти</a>
                    <a href="registr.html" class="btn btn-primary">Регистрация</a>
                </div>
            </div>
        </div>
    </header>

    <main class="main">
        <div class="container">
            <div class="auth-container">
                <h1 class="auth-title">Создать аккаунт</h1>
                
                <div class="success-message" id="successMessage">
                    ✅ Регистрация успешна! Перенаправление...
                </div>
                
                <div class="error-message" id="errorMessage">
                    ⚠️ Пожалуйста, заполните все поля корректно
                </div>

                <form id="registerForm" onsubmit="handleRegister(event)">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="firstname">Имя</label>
                            <input type="text" id="firstname" required>
                        </div>
                        <div class="form-group">
                            <label for="lastname">Фамилия</label>
                            <input type="text" id="lastname" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="username">Имя пользователя</label>
                        <input type="text" id="username" required placeholder="nickname">
                    </div>

                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" required placeholder="your@email.com">
                    </div>

                    <div class="form-group">
                        <label for="password">Пароль</label>
                        <input type="password" id="password" required placeholder="минимум 6 символов" onkeyup="checkPasswordStrength()">
                        <div class="password-strength" id="passwordStrength"></div>
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword">Подтверждение пароля</label>
                        <input type="password" id="confirmPassword" required>
                    </div>

                    <div class="form-group">
                        <label for="interests">Интересы (разработка)</label>
                        <select id="interests">
                            <option value="">Выберите основное направление</option>
                            <option>Frontend разработка</option>
                            <option>Backend разработка</option>
                            <option>Fullstack разработка</option>
                            <option>Мобильная разработка</option>
                            <option>DevOps</option>
                            <option>Data Science</option>
                            <option>UI/UX Дизайн</option>
                        </select>
                    </div>

                    <div class="checkbox-group">
                        <input type="checkbox" id="terms" required>
                        <label for="terms" style="margin: 0;">Я согласен с <a href="#" style="color:#6C9BD2">правилами форума</a> и <a href="#" style="color:#6C9BD2">политикой конфиденциальности</a></label>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width: 100%;">Зарегистрироваться</button>
                </form>

                <div class="auth-footer">
                    <p>Уже есть аккаунт? <a href="sign_in.html">Войти</a></p>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <p>© 2025 SoftForum. Сообщество разработчиков и IT-специалистов.</p>
            </div>
        </div>
    </footer>

    <script>
        function checkPasswordStrength() {
            const password = document.getElementById('password').value;
            const strengthDiv = document.getElementById('passwordStrength');
            
            if (password.length === 0) {
                strengthDiv.innerHTML = '';
                return;
            }
            
            let strength = 'weak';
            let message = '';
            
            if (password.length >= 8 && /[A-Z]/.test(password) && /[0-9]/.test(password)) {
                strength = 'strong';
                message = '✓ Надежный пароль';
            } else if (password.length >= 6) {
                strength = 'medium';
                message = '⚠ Средняя надежность';
            } else {
                strength = 'weak';
                message = '✗ Слабый пароль (минимум 6 символов)';
            }
            
            strengthDiv.innerHTML = `<span class="strength-${strength}">${message}</span>`;
        }
        
        function handleRegister(event) {
            event.preventDefault();
            
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const terms = document.getElementById('terms').checked;
            const email = document.getElementById('email').value;
            
            // Валидация
            if (password !== confirmPassword) {
                showError('Пароли не совпадают');
                return;
            }
            
            if (password.length < 6) {
                showError('Пароль должен содержать минимум 6 символов');
                return;
            }
            
            if (!terms) {
                showError('Необходимо согласиться с правилами форума');
                return;
            }
            
            if (!email.includes('@')) {
                showError('Введите корректный email');
                return;
            }
            
            // Успешная регистрация
            document.getElementById('successMessage').style.display = 'block';
            document.getElementById('errorMessage').style.display = 'none';
            
            setTimeout(() => {
                window.location.href = 'sign_in.html';
            }, 2000);
        }
        
        function showError(message) {
            const errorDiv = document.getElementById('errorMessage');
            errorDiv.textContent = `⚠️ ${message}`;
            errorDiv.style.display = 'block';
            document.getElementById('successMessage').style.display = 'none';
            
            setTimeout(() => {
                errorDiv.style.display = 'none';
            }, 3000);
        }
    </script>
</body>
</html>