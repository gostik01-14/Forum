<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SoftForum - Вход</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', sans-serif;
            background: #121417;
            color: #EAECEF;
            line-height: 1.6;
        }

        .header {
            background: #1A1D21;
            border-bottom: 1px solid #2A2F35;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 0;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #6C9BD2;
            text-decoration: none;
            transition: color 0.3s;
        }

        .logo:hover {
            color: #7EABDA;
        }

        .nav {
            display: flex;
            gap: 24px;
            align-items: center;
        }

        .nav a {
            color: #EAECEF;
            text-decoration: none;
            transition: color 0.3s;
        }

        .nav a:hover {
            color: #6C9BD2;
        }

        .btn {
            padding: 8px 16px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background: #6C9BD2;
            color: #121417;
        }

        .btn-primary:hover {
            background: #7EABDA;
            transform: translateY(-1px);
        }

        .btn-secondary {
            background: #25292E;
            color: #EAECEF;
            border: 1px solid #2A2F35;
        }

        .btn-secondary:hover {
            background: #2A2F35;
        }

        .main {
            padding: 60px 0;
            min-height: calc(100vh - 200px);
            display: flex;
            align-items: center;
        }

        .auth-container {
            max-width: 450px;
            margin: 0 auto;
            background: #1A1D21;
            border-radius: 12px;
            padding: 40px;
            border: 1px solid #2A2F35;
        }

        .auth-title {
            text-align: center;
            margin-bottom: 32px;
            font-size: 28px;
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
        }

        .form-group input {
            width: 100%;
            padding: 12px;
            background: #25292E;
            border: 1px solid #2A2F35;
            border-radius: 6px;
            color: #EAECEF;
            font-size: 16px;
            transition: all 0.3s;
        }

        .form-group input:focus {
            outline: none;
            border-color: #6C9BD2;
            box-shadow: 0 0 0 3px rgba(108, 155, 210, 0.1);
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 24px;
        }

        .checkbox-group input {
            width: auto;
            cursor: pointer;
        }

        .auth-footer {
            text-align: center;
            margin-top: 24px;
            padding-top: 24px;
            border-top: 1px solid #2A2F35;
            color: #8B949E;
        }

        .auth-footer a {
            color: #6C9BD2;
            text-decoration: none;
        }

        .auth-footer a:hover {
            text-decoration: underline;
        }

        .error-message {
            background: #2A1F1F;
            border-left: 4px solid #B5756B;
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 20px;
            color: #B5756B;
            font-size: 14px;
        }

        .footer {
            background: #1A1D21;
            border-top: 1px solid #2A2F35;
            padding: 30px 0;
        }

        .footer-content {
            text-align: center;
            color: #5C6670;
        }

        @media (max-width: 768px) {
            .header-content {
                flex-direction: column;
                gap: 16px;
            }
            
            .auth-container {
                padding: 24px;
            }
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="container">
            <div class="header-content">
                <a href="index.html" class="logo">SoftForum</a>
                <div class="nav">
                    <a href="index.html">Главная</a>
                    <a href="about.html">О нас</a>
                    <a href="answers.html">Ответы</a>
                    <a href="sign_in.html">Войти</a>
                    <a href="registr.html" class="btn btn-primary">Регистрация</a>
                </div>
            </div>
        </div>
    </header>

    <main class="main">
        <div class="container">
            <div class="auth-container">
                <h1 class="auth-title">Вход в аккаунт</h1>
                
                <div class="error-message" id="errorMessage" style="display: none;">
                    ⚠️ Неверный email или пароль
                </div>

                <form id="loginForm" onsubmit="handleLogin(event)">
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" required placeholder="your@email.com">
                    </div>

                    <div class="form-group">
                        <label for="password">Пароль</label>
                        <input type="password" id="password" required placeholder="••••••••">
                    </div>

                    <div class="checkbox-group">
                        <input type="checkbox" id="remember">
                        <label for="remember" style="margin: 0;">Запомнить меня</label>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width: 100%;">Войти</button>
                </form>

                <div class="auth-footer">
                    <p>Нет аккаунта? <a href="registr.html">Зарегистрироваться</a></p>
                    <p style="margin-top: 10px;"><a href="#">Забыли пароль?</a></p>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <p>© 2025 SoftForum. Сообщество разработчиков и IT-специалистов.</p>
            </div>
        </div>
    </footer>

    <script>
        function handleLogin(event) {
            event.preventDefault();
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            
            // Простая демо-валидация
            if (email === "test@test.com" && password === "123456") {
                window.location.href = "index.html";
            } else {
                document.getElementById('errorMessage').style.display = 'block';
                setTimeout(() => {
                    document.getElementById('errorMessage').style.display = 'none';
                }, 3000);
            }
        }
    </script>
</body>
</html>